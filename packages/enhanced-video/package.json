{
  "name": "enhanced-video-sveltekit",
  "version": "0.4.0",
  "description": "Build-time video optimization for SvelteKit. AV1 + H.264 output, auto-extracted poster, lazy loading, on-disk cache.",
  "license": "MIT",
  "author": "Victor Østergaard Nielsen <victor@voe.dk>",
  "homepage": "https://github.com/voadk/enhanced-video-sveltekit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voadk/enhanced-video-sveltekit.git",
    "directory": "packages/enhanced-video"
  },
  "bugs": {
    "url": "https://github.com/voadk/enhanced-video-sveltekit/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src/runtime",
    "src/types.ts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "svelte": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "keywords": [
    "svelte",
    "sveltekit",
    "video",
    "ffmpeg",
    "av1",
    "h264",
    "webm",
    "vite-plugin",
    "preprocessor",
    "lazy",
    "transcoding"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "check": "tsc --noEmit",
    "prepare": "tsc",
    "prepublishOnly": "rm -rf dist && tsc"
  },
  "dependencies": {
    "magic-string": "^0.30.5",
    "p-limit": "^6.0.0",
    "svelte-parse-markup": "^0.1.5",
    "zimmerframe": "^1.1.2"
  },
  "peerDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0 || ^7.0.0",
    "svelte": "^5.0.0",
    "vite": "^6.3.0 || >=7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
